<Window x:Class="KeszletManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Készlet Manager" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width"   Value="120"/>
            <Setter Property="Height"  Value="34"/>
            <Setter Property="Margin"  Value="5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"  Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Táblázat -->
        <DataGrid x:Name="TermekTabla"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5"
                  RowBackground="White"
                  BorderBrush="#CCC"
                  BorderThickness="1"
                  FontSize="13">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"         Width="60"/>
                <DataGridTextColumn Header="Termék neve" Binding="{Binding Nev}"        Width="*"/>
                <DataGridTextColumn Header="Ár (Ft)"    Binding="{Binding Ar, StringFormat='{}{0:N0} Ft'}"  Width="130"/>
                <DataGridTextColumn Header="Mennyiség"  Binding="{Binding Mennyiseg}"  Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Gombok -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">

            <Button Content="➕ Hozzáadás"
                    Background="#4CAF50" Foreground="White"
                    Click="Hozzaadas_Click"/>

            <Button Content="✏️ Szerkesztés"
                    Background="#2196F3" Foreground="White"
                    Click="Szerkesztes_Click"/>

            <Button Content="🗑️ Törlés"
                    Background="#f44336" Foreground="White"
                    Click="Torles_Click"/>
        </StackPanel>
    </Grid>
</Window>
